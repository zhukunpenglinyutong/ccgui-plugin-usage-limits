{
  "name": "ccgui-plugin-usage-limits",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "description": "CC GUI 插件「用量与限额」源码与构建脚本",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/domain/**\" --test-coverage-include=\"src/shim/**\" --test-coverage-include=\"src/data/**\" \"tests/**/*.test.ts\"",
    "preview": "node scripts/build.mjs && node preview/run.mjs",
    "assets": "node scripts/build.mjs && node scripts/make-assets.mjs"
  },
  "devDependencies": {
    "@ccgui/plugin-ui": "file:vendor/plugin-ui",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
